TELEGRAM_BOT_TOKEN=
# Optional: Local Bot API Server base URL (for >50 MB uploads).
# Example when using the commented `botapi` service in docker-compose.yml:
# TELEGRAM_API_URL=http://botapi:8081
TELEGRAM_API_URL=
FETCHLY_MAX_WORKERS=4
FETCHLY_RATE_LIMIT=20
# Max wall-clock seconds for one download pipeline (yt-dlp + convert).
FETCHLY_DOWNLOAD_TIMEOUT_SECS=900
# Max in-flight downloads per user (queued + running count).
FETCHLY_MAX_PER_USER=2
FETCHLY_DB_PATH=/data/fetchly.db
FETCHLY_TEMP_DIR=/tmp/fetchly
REDIS_URL=redis://redis:6379
RUST_LOG=fetchly=info,teloxide=warn
